@model List<Weather.Models.CurrentWeather>

@{

    ViewData["Title"] = "BCIT";
    DateTime localtime = DateTime.Now;

}


<div class="container-fluid">

@foreach(var item in Model)
{
    <h3 class="text-info">
        Our @item.Location.name campus is currently

        @item.Current.condition.text.ToLower()

        and @item.Current.temp_c&#8451; <img src="@item.Current.condition.icon" />

    </h3>
    <div class="row">
        <div class="col-sm-5 col-md-4">
            <table class="table table-hover table-sm">
                <thead>
                    <tr><th scope="col" colspan="2">Location</th></tr>
                </thead>
                <tbody>
                    <tr><td scope="row">City</td><td>@item.Location.name</td></tr>
                    <tr><td scope="row">Region</td><td>@item.Location.region</td></tr>
                    <tr><td scope="row">County</td><td>@item.Location.country</td></tr>
                    <tr><td scope="row">Latitude</td><td>@item.Location.lat</td></tr>
                    <tr><td scope="row">Longitude</td><td>@item.Location.lon</td></tr>
                </tbody>
            </table>
        </div>
        <div class="col-sm-1"></div>
        <div class="col-sm-5 col-md-4">
            <table class="table table-hover table-sm">
                <thead>
                    <tr><th scope="col" colspan="2">Local Conditions</th></tr>
                </thead>
                <tbody>
                    <tr><td scope="row">Wind Kph</td><td>@item.Current.wind_kph</td></tr>
                    <tr><td scope="row">Direction</td><td>@item.Current.wind_dir</td></tr>
                    <tr><td scope="row">Humidity</td><td>@item.Current.humidity</td></tr>
                    <tr><td scope="row">Cloud</td><td>@item.Current.cloud</td></tr>
                    <tr>
                        <td scope="row">Feels Like</td>
                        <td>@item.Current.feelslike_c&#8451;</td>
                    </tr>
                </tbody>
            </table>
        </div>
    </div>
}
</div>
