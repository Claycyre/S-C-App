@model WeatherApp.Models.NewsSectionsViewModel

<div class="news-sections-grid">
    <!-- Tech -->
    <article class="news-section" aria-label="Tech news">
        <div class="news-ribbon news-ribbon-tech"></div>
        <img class="news-section-image" src="~/images/tech.png" alt="Tech section" />

        <div class="news-items">
            @if (Model.Tech == null || !Model.Tech.Any())
            {
                <div class="news-item">
                    <div class="news-headline">Unable to load Tech right now</div>
                    <div class="news-blurb">Please refresh later.</div>
                </div>
            }
            else
            {
                foreach (var item in Model.Tech)
                {
                    <div class="news-item">
                        <div class="news-headline">
                            <a href="@item.Link" target="_blank" rel="noopener noreferrer">@item.Title</a>
                        </div>
                        @if (!string.IsNullOrWhiteSpace(item.Summary))
                        {
                            <div class="news-blurb">@item.Summary</div>
                        }
                        @if (item.Published != null)
                        {
                            <div class="news-blurb"><small class="text-muted">@item.Published.Value.LocalDateTime.ToString("MMM d, yyyy h:mm tt")</small></div>
                        }
                    </div>
                }
            }
        </div>
    </article>

